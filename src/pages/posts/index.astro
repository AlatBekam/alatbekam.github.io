---
// src/pages/posts/index.astro — All posts archive
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Posts | AlatBekam"
  description="Semua tulisan: CTF writeups, artikel, dan catatan lainnya."
>
  <div class="archive-header">
    <p class="breadcrumb-label mono">Archive</p>
    <h1 class="archive-title mono">Post archive</h1>
  </div>

  <hr class="divider" style="margin-bottom:2rem;" />

  <div class="archive-layout">
    <!-- Sidebar meta -->
    <aside class="archive-sidebar mono">
      <p>{posts.length} file{posts.length !== 1 ? 's' : ''} found</p>
      <p>sort: published</p>
      <p>desc</p>
      <p>updated: last</p>
    </aside>

    <!-- Post list -->
    <div class="archive-list">
      {posts.length === 0 && (
        <p class="empty-state mono">Belum ada post. Tambahkan file .md di <code>src/content/posts/</code>.</p>
      )}
      {posts.map(post => (
        <><PostCard post={post} /><hr class="divider" /></>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-header {
    margin-bottom: 1.5rem;
  }

  .breadcrumb-label {
    font-size: 0.75rem;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }

  .archive-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--on-container);
  }

  .archive-layout {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .archive-sidebar {
    font-size: 0.775rem;
    color: var(--muted);
    line-height: 1.8;
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 640px) {
    .archive-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .archive-sidebar {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
    }
  }

  .empty-state {
    font-size: 0.875rem;
    color: var(--muted);
    padding: 2rem 0;
  }
</style>
