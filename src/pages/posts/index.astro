---
// src/pages/posts/index.astro — All posts archive
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Posts | AlatBekam"
  description="Semua tulisan: CTF writeups, artikel, dan catatan lainnya."
>
  <div class="archive-header">
    <p class="breadcrumb-label mono">Archive</p>
    <h1 class="archive-title mono">Post archive</h1>
  </div>

  <hr class="divider" style="margin-bottom:2rem;" />

  <div class="archive-layout">
    <!-- Sidebar meta -->
    <aside class="archive-sidebar mono">
      <p>{posts.length} file{posts.length !== 1 ? 's' : ''} found</p>
      <p>sort: published</p>
      <p>desc</p>
      <p>updated: last</p>
    </aside>

    <!-- Post list -->
    <div class="archive-list">
      {posts.length === 0 && (
        <p class="empty-state mono">Maaf, belum ada post :(. Tunggu updatenya yaa!.</p>
      )}
      {posts.map(post => (
        <><PostCard post={post} /><hr class="divider" /></>
      ))}
    </div>
  </div>
</BaseLayout>

