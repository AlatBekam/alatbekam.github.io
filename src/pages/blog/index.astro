---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import BlogCard from '../../components/BlogCard.astro';
import TagBadge from '../../components/TagBadge.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog - AlatBekam">
  <Navbar />
  <main class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold mb-2">Blog</h1>
      <p class="text-gray-500 mb-8">CTF writeups, project logs, and notes.</p>

      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8" id="tag-filter">
          <TagBadge tag="all" active={true} />
          {allTags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}

      <div id="blog-list" class="space-y-4">
        {allPosts.length > 0 ? (
          allPosts.map((post) => (
            <div class="blog-item" data-tags={JSON.stringify(post.data.tags)}>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                tags={post.data.tags}
                slug={post.id}
              />
            </div>
          ))
        ) : (
          <p class="text-gray-400 text-center py-10">No posts yet. Check back soon!</p>
        )}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  function initTagFilter() {
    const params = new URLSearchParams(window.location.search);
    const tagParam = params.get('tag');
    const items = document.querySelectorAll<HTMLElement>('.blog-item');
    const badges = document.querySelectorAll<HTMLAnchorElement>('#tag-filter a');

    badges.forEach((badge) => {
      const tag = badge.textContent?.trim();
      if (tagParam && tag === tagParam) {
        badge.classList.add('bg-accent', 'text-dark', 'font-bold');
        badge.classList.remove('bg-gray-100', 'text-gray-600');
      } else if (!tagParam && tag === 'all') {
        badge.classList.add('bg-accent', 'text-dark', 'font-bold');
        badge.classList.remove('bg-gray-100', 'text-gray-600');
      }
    });

    if (tagParam) {
      items.forEach((item) => {
        const tags = JSON.parse(item.dataset.tags || '[]');
        if (!tags.includes(tagParam)) {
          item.style.display = 'none';
        }
      });
    }
  }

  initTagFilter();
  document.addEventListener('astro:after-swap', initTagFilter);
</script>
