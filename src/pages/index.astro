---
// src/pages/index.astro — Home page
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Get latest 3 posts and 3 projects (not drafts), sorted by date desc
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const allProjects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const latestPosts    = allPosts.slice(0, 3);
const latestProjects = allProjects.slice(0, 3);

// Latest updates = merge posts + projects, sort by date, take 5
type AnyEntry = { type: 'post' | 'project'; date: Date; entry: typeof allPosts[0] | typeof allProjects[0] };
const merged: AnyEntry[] = [
  ...allPosts.map(p => ({ type: 'post' as const, date: p.data.publishDate, entry: p })),
  ...allProjects.map(p => ({ type: 'project' as const, date: p.data.publishDate, entry: p })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 5);
---

<BaseLayout
  title="./AlatBekam – Portofolio"
  description="Portofolio pribadi AlatBekam — CTF writeups, projects, dan tulisan lainnya."
>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-avatar" aria-hidden="true">
      <img src="/images/hero-image-light.png" alt="" class="hero-img hero-img--light" />
      <img src="/images/hero-image-dark.png"  alt="" class="hero-img hero-img--dark" />
    </div>

    <h1 class="hero-title mono">
      Hi, I'm <span class="hero-name">AlatBekam.</span>
    </h1>

    <!-- 
      TODO: Ganti teks bio di bawah ini dengan bio singkat kamu sendiri.
      Contoh: "I like breaking things. Here, I post stuff I learned while doing CTFs."
    -->
    <p class="hero-bio">
      <!-- Bio kamu di sini -->
    </p>

    <!-- Social links -->
    <div class="hero-socials" aria-label="Social media links">
      <a href="https://github.com/alatbekam" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
        <ion-icon name="logo-github"></ion-icon>
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
        <ion-icon name="logo-linkedin"></ion-icon>
      </a>
      <a href="https://discord.com" target="_blank" rel="noopener noreferrer" aria-label="Discord" class="social-link">
        <ion-icon name="logo-discord"></ion-icon>
      </a>
      <a href="mailto:email@example.com" aria-label="Email" class="social-link">
        <ion-icon name="mail-outline"></ion-icon>
      </a>
    </div>

    <!-- Quick nav -->
    <nav class="hero-nav mono" aria-label="Quick navigation">
      <a href="/posts">[posts]</a>
      <a href="/projects">[projects]</a>
      <a href="/about">[about]</a>
    </nav>
  </section>

  <!-- ── Latest Updates ───────────────────────────────────────── -->
  <section class="home-section" aria-labelledby="updates-heading">
    <h2 class="section-heading mono" id="updates-heading">
      Latest Updates
      <span class="section-count">({merged.length})</span>
    </h2>

    <div class="card-list">
      {merged.map(({ type, entry }) => (
        type === 'post'
          ? <><PostCard post={entry as typeof allPosts[0]} /><hr class="divider" /></>
          : <><ProjectCard project={entry as typeof allProjects[0]} /><hr class="divider" /></>
      ))}
    </div>

    <a href="/posts" class="view-all mono">view all updates ↗</a>
  </section>

  <!-- ── Latest Posts ─────────────────────────────────────────── -->
  {latestPosts.length > 0 && (
    <section class="home-section" aria-labelledby="posts-heading">
      <h2 class="section-heading mono" id="posts-heading">
        Latest Posts
        <span class="section-count">({allPosts.length} total)</span>
      </h2>

      <div class="card-list">
        {latestPosts.map(post => (
          <><PostCard post={post} /><hr class="divider" /></>
        ))}
      </div>

      <a href="/posts" class="view-all mono">view all posts ↗</a>
    </section>
  )}

  <!-- ── Latest Projects ──────────────────────────────────────── -->
  {latestProjects.length > 0 && (
    <section class="home-section" aria-labelledby="projects-heading">
      <h2 class="section-heading mono" id="projects-heading">
        Latest Projects
        <span class="section-count">({allProjects.length} total)</span>
      </h2>

      <div class="card-list">
        {latestProjects.map(project => (
          <><ProjectCard project={project} /><hr class="divider" /></>
        ))}
      </div>

      <a href="/projects" class="view-all mono">view all projects ↗</a>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 2rem 0 3.5rem;
    border-bottom: 1px dashed var(--border);
    margin-bottom: 3rem;
  }

  .hero-avatar {
    margin-bottom: 1.25rem;
  }

  .hero-img {
    display: block;
    height: 96px;
    width: auto;
    object-fit: contain;
  }

  /* Light mode: show light image, hide dark image */
  html:not(.dark) .hero-img--dark  { display: none; }

  /* Dark mode: show dark image, hide light image */
  html.dark .hero-img--light { display: none; }


  .hero-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.875rem;
    line-height: 1.2;
    color: var(--on-container);
  }

  .hero-name {
    color: var(--primary);
  }

  .hero-bio {
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 55ch;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    min-height: 1rem; /* keeps spacing even when empty */
  }

  .hero-socials {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .social-link {
    font-size: 1.375rem;
    color: var(--muted);
    transition: color 0.15s, transform 0.15s;
    display: flex;
    align-items: center;
  }
  .social-link:hover {
    color: var(--primary);
    opacity: 1;
    transform: translateY(-2px);
  }

  .hero-nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-nav a {
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 0.15s;
  }
  .hero-nav a:hover {
    color: var(--primary);
    opacity: 1;
  }

  /* ── Sections ── */
  .home-section {
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary);
    margin-bottom: 0.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .section-count {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .card-list {
    margin-top: 0.5rem;
  }

  .view-all {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.5rem;
    transition: color 0.15s;
  }
  .view-all:hover {
    color: var(--primary);
    opacity: 1;
  }
</style>
