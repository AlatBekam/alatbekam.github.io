---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="About - AlatBekam">
  <Navbar />
  <main class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold mb-8">About Me</h1>

      <div class="prose space-y-6">
        <p>
          Hi, I'm <strong>Hisara</strong> &mdash; a front-end developer and security enthusiast
          from Pontianak, Indonesia.
        </p>

        <p>
          I started learning web development in July 2022 during my time at SMKN 4 Pontianak.
          Since then, I've been building web applications and exploring the world of
          cybersecurity through CTF (Capture The Flag) competitions.
        </p>

        <h2>What I Do</h2>
        <ul>
          <li><strong>Web Development</strong> &mdash; Building modern web apps with HTML, CSS, JavaScript, and various frameworks.</li>
          <li><strong>Mobile Development</strong> &mdash; Creating mobile applications.</li>
          <li><strong>CTF</strong> &mdash; Participating in CTF competitions, focusing on web exploitation, forensics, and cryptography.</li>
        </ul>

        <h2>Connect</h2>
        <p>
          You can find me on
          <a href="https://github.com/AlatBekam" target="_blank">GitHub</a>,
          <a href="https://www.instagram.com/hiisara_/" target="_blank">Instagram</a>, and
          <a href="https://bit.ly/3SXxTBn" target="_blank">YouTube</a>.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
