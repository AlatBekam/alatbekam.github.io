---
// src/pages/about.astro — About page
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout
  title="About | AlatBekam"
  description="Tentang AlatBekam — cybersecurity enthusiast, CTF player."
>
  <div class="about-header">
    <p class="breadcrumb-label mono">About</p>
    <h1 class="about-title mono">whoami</h1>
  </div>

  <hr class="divider" style="margin-bottom:2.5rem;" />

  <div class="about-content">

    <p class="about-intro">
      Hi, my name is <strong class="about-strong">AlatBekam</strong>, Just an average collage student from Pontianak, West Borneo, Indonesia. Intrested in security thingy, but forced to become Mobile Developer hehe.
      <!-- Ganti dengan bio lengkap kamu di sini. -->
    </p>

    <!-- Sosial media -->
    <div class="about-socials">
      <SocialLinks variant="list"/>
    </div>

    <!-- CTF Section -->
    <section class="about-section">
      <h2 class="about-section-title mono">Selected CTFs</h2>
      <p class="about-section-desc">
      </p>

      <div class="ctf-tables">
        <h3 class="table-title mono">International CTFs</h3>
        <table class="ctf-table">
          <thead>
            <tr>
              <th>Competition</th>
              <th>Team</th>
              <th>Position</th>
              <th>Solved</th>
            </tr>
          </thead>
          <tbody>
            <!-- LIST SECTION-->
            <tr>
              <td>The Cyber Jawara International 2024</td>
              <td>Ekstrak Daun Mengkudu sebagai Solusi Naiknya Tingkat Depresi pada Mahasiswa Komputer as Hisara</td>
              <td>9th Place</td>
              <td>Forget hehe, but trust me im on that team!</td>
            </tr>

            <tr>
              <td>gaslightCTF 2026</td>
              <td>BauPesing as hisaraa</td>
              <td>86th Place (3744 pts)</td>
              <td>15/35</td>
            </tr>
          </tbody>
        </table>

        <h3 class="table-title mono" style="margin-top:1.5rem;">Local CTFs</h3>
        <table class="ctf-table">
          <thead>
            <tr>
              <th>Competition</th>
              <th>Team</th>
              <th>Position</th>
              <th>Solved</th>
            </tr>
          </thead>
          <tbody>
            <!-- LIST SECTION-->
            <tr>
              <td>Finalist GEMASTIK 2025</td>
              <td>YourTeam</td>
              <td>ofc just isi slot hehe</td>
              <td>1/5</td>
            </tr>

            <tr>
              <td>WMS CTF 2026</td>
              <td>BauPesing</td>
              <td>Forgot</td>
              <td>12/50</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="about-section">
      <h2 class="about-section-title mono">Skills</h2>
      <div class="skills-grid">
        <!-- TODO: Tambah atau hapus skill sesuai kebutuhanmu -->
        {['Web Exploitation', 'Binary Exploitation', 'Reverse Engineering', 'Cryptography', 'OSINT', 'Linux'].map(skill => (
          <span class="tag">{skill}</span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* .breadcrumb-label → global.css */

  .about-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--on-container);
  }

  .about-strong {
    color: var(--primary);
    font-weight: 700;
  }

  .about-content {
    max-width: 680px;
  }

  .about-intro {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--on-container);
    margin-bottom: 1.75rem;
  }

  .about-socials {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 2.5rem;
  }

  /* .social-item styles → SocialLinks.astro (.socials-list, .social-item) */

  .about-section {
    margin-bottom: 2.5rem;
  }

  .about-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-container);
    margin-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border);
    padding-bottom: 0.5rem;
  }

  .about-section-desc {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .table-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .ctf-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .ctf-table th,
  .ctf-table td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .ctf-table th {
    background: var(--surface);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
