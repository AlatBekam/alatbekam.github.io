---
// Footer.astro
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="mono footer-copy">© {year} AlatBekam</span>
    <div class="footer-links">
      <SocialLinks variant="footer" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-link {
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 0.15s;
  }
  .footer-link:hover { color: var(--primary); opacity: 1; }
</style>
