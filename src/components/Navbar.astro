---
// Navbar.astro
import ThemeToggle from './ThemeToggle.astro';
const navLinks = [
  { href: '/',         label: 'home/' },
  { href: '/posts',    label: 'posts/' },
  { href: '/projects', label: 'projects/' },
  { href: '/about',    label: 'about/' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-nav">
  <nav class="nav-inner">
    <!-- Logo / Brand -->
    <a href="/" class="nav-brand mono">./AlatBekam</a>

    <!-- Mobile hamburger -->
    <button id="nav-toggle" class="nav-hamburger" aria-label="Open menu" aria-expanded="false">
      <ion-icon name="menu-outline" style="font-size:1.5rem;"></ion-icon>
    </button>

    <!-- Nav links + toggle -->
    <div id="nav-menu" class="nav-menu">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link mono ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--container);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: color-mix(in srgb, var(--container) 88%, transparent);
    transition: background 0.25s;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 900px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    gap: 1rem;
  }

  .nav-brand {
    font-size: 1rem;
    font-weight: 500;
    color: var(--on-container);
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .nav-brand:hover { color: var(--primary); opacity: 1; }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 0.15s;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active { color: var(--primary); opacity: 1; }

  /* Hamburger - hidden on desktop */
  .nav-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--on-container);
    padding: 0.25rem;
  }

  /* Mobile */
  @media (max-width: 600px) {
    .nav-hamburger { display: flex; align-items: center; }

    .nav-menu {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
      width: 100%;
      padding: 1rem 0 0.5rem;
    }
    .nav-menu.open { display: flex; }
    .nav-inner { flex-wrap: wrap; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
