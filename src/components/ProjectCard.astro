---
interface Props {
  title: string;
  description: string;
  image?: string;
  link?: string;
  github?: string;
  tags?: string[];
}

const { title, description, image, link, github, tags = [] } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
  {image && (
    <a href={link || github || '#'}>
      <img src={image} alt={title} class="w-full h-48 object-cover" />
    </a>
  )}
  <div class="p-5">
    <h3 class="font-bold text-lg mb-2">{title}</h3>
    <p class="text-gray-600 text-sm mb-4">{description}</p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 text-xs font-mono bg-gray-100 text-gray-600 rounded">
            {tag}
          </span>
        ))}
      </div>
    )}
    <div class="flex gap-3">
      {link && (
        <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-dark hover:text-accent transition-colors">
          Live Demo &rarr;
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-dark hover:text-accent transition-colors">
          Source Code &rarr;
        </a>
      )}
    </div>
  </div>
</div>
