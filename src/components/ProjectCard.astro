---
// ProjectCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, publishDate, tags, thumbnail, repoUrl, liveUrl } = project.data;

const formattedDate = publishDate.toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const thumbSrc = thumbnail ? `/images/projects/${thumbnail}` : null;
---

<article class="project-card">
  {thumbSrc && (
    <a href={`/projects/${project.id.replace(/\.(md|mdx)$/, '')}`} class="project-thumb-link">
      <div class="project-thumb">
        <img src={thumbSrc} alt={`Thumbnail ${title}`} loading="lazy" />
      </div>
    </a>
  )}

  <div class="project-body">
    <div class="project-meta mono">
      <span>{formattedDate}</span>
    </div>

    <h2 class="project-title mono">
      <a href={`/projects/${project.id.replace(/\.(md|mdx)$/, '')}`}>{title}</a>
    </h2>

    <p class="project-desc">{description}</p>

    {tags.length > 0 && (
      <div class="project-tags">
        {tags.map(tag => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}

    <div class="project-actions">
      <a href={`/projects/${project.id.replace(/\.(md|mdx)$/, '')}`} class="project-action-link mono">detail ↗</a>
      {repoUrl && (
        <a href={repoUrl} class="project-action-link mono" target="_blank" rel="noopener noreferrer">
          <ion-icon name="logo-github" style="vertical-align:middle;margin-right:0.2em;"></ion-icon>repo ↗
        </a>
      )}
      {liveUrl && (
        <a href={liveUrl} class="project-action-link mono" target="_blank" rel="noopener noreferrer">
          <ion-icon name="globe-outline" style="vertical-align:middle;margin-right:0.2em;"></ion-icon>live ↗
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    align-items: start;
  }

  @media (max-width: 600px) {
    .project-card { grid-template-columns: 1fr; }
  }

  .project-thumb-link { display: block; }

  .project-thumb {
    width: 160px;
    height: 100px;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .project-thumb { width: 100%; height: 180px; }
  }

  .project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .project-thumb:hover img { transform: scale(1.04); }

  /* No-thumbnail fallback: single column */
  .project-card:not(:has(.project-thumb-link)) {
    grid-template-columns: 1fr;
  }

  .project-body { min-width: 0; }

  .project-meta {
    font-size: 0.775rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .project-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .project-title a {
    color: var(--on-container);
    transition: color 0.15s;
  }
  .project-title a:hover { color: var(--primary); }

  .project-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .project-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-action-link {
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 0.15s;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .project-action-link:hover { color: var(--primary); opacity: 1; }
</style>
