---
interface Props {
  tag: string;
  active?: boolean;
}

const { tag, active = false } = Astro.props;
---

<a
  href={`/blog?tag=${encodeURIComponent(tag)}`}
  class:list={[
    'px-3 py-1 text-xs font-mono rounded-full transition-colors',
    active
      ? 'bg-accent text-dark font-bold'
      : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-dark dark:hover:bg-white hover:text-white dark:hover:text-dark',
  ]}
>
  {tag}
</a>
