---
// TableOfContents.astro
// Renders a sticky ToC from headings passed as props
// Usage: <TableOfContents headings={headings} />

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
// Only h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 1 && (
  <aside class="toc-aside" aria-label="Table of contents">
    <nav class="toc-nav">
      <p class="toc-label mono">Contents</p>
      <ul class="toc-list">
        {tocHeadings.map(h => (
          <li class={`toc-item depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="toc-link mono">{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<style>
  .toc-aside {
    position: sticky;
    top: 5rem;
    width: 220px;
    flex-shrink: 0;
    align-self: flex-start;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }

  .toc-nav {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    transition: border-color 0.2s;
  }

  .toc-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .toc-item.depth-3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    font-size: 0.775rem;
    color: var(--muted);
    line-height: 1.5;
    display: block;
    transition: color 0.15s;
    padding: 0.1rem 0;
  }

  .toc-link:hover,
  .toc-link.active {
    color: var(--primary);
    opacity: 1;
  }
</style>

<script>
  // Highlight active heading on scroll
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  if (links.length > 0) {
    const headingEls = Array.from(links).map(link => {
      const id = link.getAttribute('href')?.replace('#', '');
      return id ? document.getElementById(id) : null;
    }).filter(Boolean) as HTMLElement[];

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          const id = entry.target.id;
          const link = document.querySelector<HTMLAnchorElement>(`.toc-link[href="#${id}"]`);
          if (link) {
            if (entry.isIntersecting) {
              document.querySelectorAll('.toc-link').forEach(l => l.classList.remove('active'));
              link.classList.add('active');
            }
          }
        });
      },
      { rootMargin: '-20% 0% -70% 0%', threshold: 0 }
    );

    headingEls.forEach(el => observer.observe(el));
  }
</script>
