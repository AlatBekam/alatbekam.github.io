---
interface Props {
  title: string;
  date: Date;
  tags?: string[];
  image?: string;
}

const { title, date, tags = [], image } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="prose">
  <header class="mb-8 not-prose">
    {image && (
      <img src={image} alt={title} class="w-full h-64 object-cover rounded-lg mb-6" />
    )}
    <h1 class="text-4xl font-bold mb-3">{title}</h1>
    <time class="text-gray-500 dark:text-gray-400 text-sm">{formattedDate}</time>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-3">
        {tags.map((tag) => (
          <a
            href={`/blog?tag=${encodeURIComponent(tag)}`}
            class="px-3 py-1 text-xs font-mono bg-dark dark:bg-gray-700 text-white rounded-full hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </header>
  <div class="prose">
    <slot />
  </div>
</article>
